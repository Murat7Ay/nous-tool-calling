<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>NousToolCalling</PackageId>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NousToolCalling</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <Title>NousToolCalling</Title>
    <Description>Prompt-based (Nous-style) tool calling for IChatClient. Makes on-prem / OpenAI-compatible models (Qwen, Hermes, DeepSeek via vLLM, llama.cpp, Ollama) that emit &lt;tool_call&gt; XML in plain text work with FunctionInvokingChatClient and Microsoft Agent Framework tools.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0" />
  </ItemGroup>

</Project>
