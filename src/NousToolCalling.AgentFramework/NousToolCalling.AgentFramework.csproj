<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>NousToolCalling.AgentFramework</PackageId>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NousToolCalling.AgentFramework</RootNamespace>
    <Description>Composition helpers for Nous-style tool calling with Microsoft Agent Framework: a one-call ChatClientAgent pipeline for on-prem OpenAI-compatible models and an MCP tool host that exposes server tools as AIFunctions.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NousToolCalling\NousToolCalling.csproj" />
    <PackageReference Include="Microsoft.Agents.AI" Version="1.23.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
  </ItemGroup>

</Project>
